# MongoDB connection used by the application.
MONGO_URI=mongodb://127.0.0.1:27017/agentic_qa

# Base URL of the demo web application.
DEFAULT_BASE_URL=http://127.0.0.1:8000

# Path to the separate Playwright project, relative to agent-app.
PLAYWRIGHT_PROJECT_PATH=../playwright-tests

# LLM client mode: live, record, replay, or auto.
LLM_MODE=auto
